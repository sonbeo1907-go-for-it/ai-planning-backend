# Copy to .env.sandbox; loaded only with the sandbox Spring profile.
# This is a Java properties file: use unquoted KEY=value, not export or shell expressions.
# Keep disabled until real SANDBOX merchant credentials have been filled in.
BILLING_PAYMENTS_ENABLED=false
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=http://localhost:3000/billing/checkout/result
VNPAY_SERVER_IP=127.0.0.1
VNPAY_TIMEOUT_SECONDS=10
# Optional: only trust a known immediate proxy that sanitizes X-Forwarded-For.
# APP_BILLING_TRUSTED_PROXY_ADDRESSES=127.0.0.1,::1
# Register https://<backend-tunnel-host>/api/v1/billing/vnpay-ipn with VNPay.
# IPN URL is merchant-side configuration, not VNPAY_RETURN_URL or a backend env variable.
