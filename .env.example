POSTGRES_DB=ai_planning
POSTGRES_USER=ai_planning
POSTGRES_PASSWORD=ai_planning_local
DB_URL=jdbc:postgresql://localhost:5432/ai_planning
DB_USERNAME=ai_planning
DB_PASSWORD=ai_planning_local
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters
JWT_EXPIRATION=PT15M
AUTH_SESSION_EXPIRATION=P14D
REFRESH_LOCK_DURATION=PT10S
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAME_SITE=Strict
AUTH_REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TIMEOUT=2s
LOGIN_MAX_ATTEMPTS=5
LOGIN_BLOCK_DURATION=PT15M
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=replace-with-your-google-web-client-id.apps.googleusercontent.com
CORS_ALLOWED_ORIGINS=http://localhost:3000
AI_ALLOW_INSECURE_HTTP_PROVIDER_BASE_URLS=false
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
BILLING_PAYMENTS_ENABLED=false
BILLING_WELCOME_CREDITS=1000
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_QUERY_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_RETURN_URL=http://localhost:3000/billing/checkout/result
VNPAY_SERVER_IP=127.0.0.1
VNPAY_TIMEOUT_SECONDS=10
# Trust forwarding headers only from an explicitly configured, header-sanitizing reverse proxy.
# APP_BILLING_TRUSTED_PROXY_ADDRESSES=127.0.0.1,::1
