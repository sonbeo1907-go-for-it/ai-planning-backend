POSTGRES_PASSWORD=ai_planning_local
DB_URL=jdbc:postgresql://localhost:5432/ai_planning
DB_USERNAME=ai_planning
DB_PASSWORD=ai_planning_local
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters
JWT_EXPIRATION=PT15M
AUTH_SESSION_EXPIRATION=P14D
REFRESH_LOCK_DURATION=PT10S
REFRESH_COOKIE_NAME=refresh_token
